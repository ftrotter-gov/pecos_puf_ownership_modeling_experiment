###############################################################################
# example.env — template for your local .env
###############################################################################
#
# This file is committed. Your .env is NOT, and must never be: it is excluded
# by .gitignore because the database you point at is a local choice, and may
# carry credentials.
#
# SETUP — you must do this once before running the checks:
#
#     cp example.env .env
#
# InLaw then auto-discovers .env when you run `inlaw inlaw_tests` from the
# repository root. No --db-config-file flag needed.
#
#     pip install -r requirements.txt   # Python 3.10-3.13
#     python build_hierarchy.py         # populates the database
#     inlaw inlaw_tests                 # runs the checks
#
# These variables configure InLaw (https://pypi.org/project/inlaw/). It reads
# every variable prefixed with INLAW_.
#
###############################################################################


###############################################################################
# Database connection
###############################################################################
#
# DuckDB is the DEFAULT, not a requirement.
#
# The repository assumes DuckDB because it needs no server and keeps the whole
# pipeline reproducible from a single file. If you accept that default, copy
# this file to .env and you are done.
#
# Nothing here is locked to DuckDB. The pipeline writes through pandas and the
# checks query through SQLAlchemy, so any SQLAlchemy-supported database works.
# Two things to change if you switch:
#
#   1. INLAW_URL below.
#   2. write_to_duckdb() in build_hierarchy.py, the only place the DuckDB
#      driver is used directly.
#
# InLaw itself imposes no database at all: a check can validate a pandas
# DataFrame in-process and ignore the connection entirely. See
# inlaw_tests/test_regex_terms_match_known_cases.py for an example.
#
# Configure EITHER option 1 (a single URL) OR option 2 (components), not both.

# --- Option 1: complete SQLAlchemy connection URL (recommended) -------------
#
# The default: a local DuckDB file written by build_hierarchy.py. The path is
# relative, so run inlaw from the repository root. Note the three slashes --
# `duckdb:///` followed by the relative path `data/pecos.duckdb`.

INLAW_URL=duckdb:///data/pecos.duckdb

# Other databases -- uncomment one instead, and comment out the line above.
# Install the matching driver first:
#     pip install 'inlaw[postgres]'   or   pip install 'inlaw[mysql]'
#
# INLAW_URL=postgresql://user:password@localhost:5432/pecos
# INLAW_URL=mysql+pymysql://user:password@localhost:3306/pecos
# INLAW_URL=sqlite:///data/pecos.sqlite
#
# In-memory DuckDB, for throwaway runs (nothing persists):
# INLAW_URL=duckdb:///:memory:


# --- Option 2: individual components (leave commented unless needed) --------
#
# Equivalent to the URL above. Only set these if INLAW_URL is unset.
#
# INLAW_DIALECT=duckdb
# INLAW_DATABASE=data/pecos.duckdb

# Full set of supported component variables, for reference:
#
#   INLAW_DIALECT    required*   duckdb | postgresql | mysql | sqlite
#   INLAW_DRIVER     optional    e.g. psycopg2, pymysql
#   INLAW_USER       required*   database username
#   INLAW_PASSWORD   optional    database password
#   INLAW_HOST       required*   e.g. localhost
#   INLAW_PORT       optional    e.g. 5432
#   INLAW_DATABASE   required*   database name, or file path for DuckDB/SQLite
#
#   * Required only when using option 2 and only where meaningful for the
#     dialect — a file-based DuckDB needs just INLAW_DIALECT and
#     INLAW_DATABASE, with no user/host/port.
#
# Example for PostgreSQL instead of DuckDB:
#
#   INLAW_URL=postgresql://user:password@localhost:5432/pecos
#
# or component-wise:
#
#   INLAW_DIALECT=postgresql
#   INLAW_DRIVER=psycopg2
#   INLAW_USER=myuser
#   INLAW_PASSWORD=mypassword
#   INLAW_HOST=localhost
#   INLAW_PORT=5432
#   INLAW_DATABASE=pecos


###############################################################################
# Input data (optional)
###############################################################################
#
# The CMS public-use CSVs are not committed; see data/README.md for where to
# download them. Uncomment and adjust if your filenames differ from the
# defaults baked into the pipeline.
#
# PECOS_DATA_DIR=data
# PECOS_ENROLLMENT_FILE=Hospital_Enrollments_2026.07.31.csv
# PECOS_ALLOWNERS_FILE=Hospital_All_Owners_2026.07.31_update.csv


###############################################################################
# Reminder
###############################################################################
#
# Never commit a real .env. If you add a variable here, use a placeholder or a
# non-sensitive default — this file is public.
