# Evidence build artifacts. All regenerated by `make sources && make site`.
node_modules/
.evidence/
build/

# Parquet extracted from DuckDB by `evidence sources`. Derived data -- the
# database in data/ is the source of truth, and it is gitignored too.
static/data/

# Evidence writes credentials here when a source is configured interactively.
# connection.yaml itself is committed (it holds only a relative file path, no
# secrets); this companion file must never be.
sources/**/connection.options.yaml
